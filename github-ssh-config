#!/usr/bin/env bash

set -e

# ----------------------------------------------#
# SSH directory                                 #
# ----------------------------------------------#

SSH_DIR="$HOME/.ssh"

mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"


# ----------------------------------------------#
# Install GitHub CLI                            #
# ----------------------------------------------#

curl -sS https://webi.sh/gh | sh

if [ -f "$HOME/.config/envman/PATH.env" ]; then
    source "$HOME/.config/envman/PATH.env"
fi


# ----------------------------------------------#
# Load .env                                     #
# ----------------------------------------------#

if [ ! -f ".env" ]; then
    echo "Erro: arquivo .env não encontrado."
    exit 1
fi

set -o allexport
source ".env"
set +o allexport


# ----------------------------------------------#
# Validate required variables                   #
# ----------------------------------------------#

required_vars=(
    PROJECT_NAME
    ENVIRONMENT
    GITHUB_HOST
    PROJECT_WORKDIR
)

for var in "${required_vars[@]}"; do
    if [ -z "${!var:-}" ]; then
        echo "Erro: variável $var não definida no .env"
        exit 1
    fi
done


# ----------------------------------------------#
# SSH key filenames                             #
# ----------------------------------------------#

rsa_deploy_workflow_file_name="$SSH_DIR/id_rsa_${PROJECT_NAME}_${ENVIRONMENT}_deploy_workflow"

ed_deploy_key_github_file_name="$SSH_DIR/id_ed25519_${PROJECT_NAME}_${ENVIRONMENT}_github_deploy_key"

env_secrets_file_name=".env.secrets"


# ----------------------------------------------#
# Generate passphrase                           #
# ----------------------------------------------#

rsa_deploy_key_passphrase="$(openssl rand -base64 32)"


# ----------------------------------------------#
# Generate SSH Key to Github Workflow deploy    #
# ----------------------------------------------#

echo ""
echo "=============================================="
echo "Gerando chave RSA para GitHub Workflow"
echo "=============================================="

ssh-keygen \
    -t rsa \
    -b 4096 \
    -C "Github Workflow Key $PROJECT_NAME $ENVIRONMENT" \
    -f "$rsa_deploy_workflow_file_name" \
    -N "$rsa_deploy_key_passphrase"


# ----------------------------------------------#
# Generate SSH Key to Github Deploy Key         #
# ----------------------------------------------#

echo ""
echo "=============================================="
echo "Gerando chave ED25519 para GitHub"
echo "=============================================="

ssh-keygen \
    -t ed25519 \
    -C "Github Deploy Key $PROJECT_NAME $ENVIRONMENT" \
    -f "$ed_deploy_key_github_file_name" \
    -N ""


# ----------------------------------------------#
# Authorized SSH Keys                           #
# ----------------------------------------------#

echo ""
echo "=============================================="
echo "Configurando authorized_keys"
echo "=============================================="

touch "$SSH_DIR/authorized_keys"

cat "$rsa_deploy_workflow_file_name.pub" >> "$SSH_DIR/authorized_keys"
cat "$ed_deploy_key_github_file_name.pub" >> "$SSH_DIR/authorized_keys"

chmod 600 "$SSH_DIR/authorized_keys"


# ----------------------------------------------#
# SSH config                                    #
# ----------------------------------------------#

echo ""
echo "=============================================="
echo "Configurando SSH"
echo "=============================================="

touch "$SSH_DIR/config"

cat >> "$SSH_DIR/config" <<EOF

Host $GITHUB_HOST
    HostName github.com
    IdentityFile $ed_deploy_key_github_file_name
    IdentitiesOnly yes

EOF

chmod 600 "$SSH_DIR/config"


# ----------------------------------------------#
# GitHub Secrets Manager Token                   #
# ----------------------------------------------#

echo ""
read -r -s -p "Informe o Token Gerenciador de Secrets: " github_secrets_manager
echo ""


# ----------------------------------------------#
# Write .env.secrets                            #
# ----------------------------------------------#

echo ""
echo "=============================================="
echo "Criando .env.secrets"
echo "=============================================="

echo "SERVER_USER=\"$(whoami)\"" > "$env_secrets_file_name"

SERVER_HOST="$(curl -4 -s --fail ifconfig.me)"

echo "SERVER_HOST=\"$SERVER_HOST\"" >> "$env_secrets_file_name"

echo "${ENVIRONMENT}_SSH_PASSPHRASE=\"$rsa_deploy_key_passphrase\"" \
    >> "$env_secrets_file_name"

echo "${ENVIRONMENT}_SSH_KEY=\"$(cat "$rsa_deploy_workflow_file_name")\"" \
    >> "$env_secrets_file_name"

echo 'SSH_PORT="22"' >> "$env_secrets_file_name"


# ----------------------------------------------#
# Login GitHub CLI                              #
# ----------------------------------------------#

echo ""
echo "=============================================="
echo "Login no GitHub CLI"
echo "=============================================="

printf '%s\n' "$github_secrets_manager" | gh auth login --with-token


# ----------------------------------------------#
# Set GitHub Secrets                            #
# ----------------------------------------------#

echo ""
echo "=============================================="
echo "Enviando secrets para GitHub"
echo "=============================================="

gh secret set -f "$env_secrets_file_name"

# ----------------------------------------------#
# Finish                                        #
# ----------------------------------------------#

echo ""
echo "=============================================="
echo "Configuração concluída!"
echo "=============================================="

echo ""
echo "SSH directory:"
echo "$SSH_DIR"

echo ""
echo "RSA Workflow Key:"
echo "$rsa_deploy_workflow_file_name"

echo ""
echo "GitHub Deploy Key:"
cat "$ed_deploy_key_github_file_name"

echo ""
echo "Project:"
echo "$PROJECT_WORKDIR"

echo ""
